# Copiá este archivo como backend/.env y completá los valores. `npm run dev` y `npm start` lo leen solos.

# En el servidor de la nube: production. Así la API exige las variables marcadas como obligatorias.
NODE_ENV=production

# Obligatoria en producción. Clave para firmar las sesiones, de al menos 32 caracteres.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Solo se usa la primera vez, con la base vacía, para crear el usuario admin (mínimo 8 caracteres).
ADMIN_PASSWORD=

# Opcionales
# Solo si la web corre en otra dirección que la API (si la sirve la propia API no hace falta).
# CORS_ORIGIN=https://gestion.midominio.com
# PORT=4000
# DB_PATH=/datos/app.db
# WEB_DIR=../frontend/out
# BACKUP_DIR=/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# TIME_ZONE=America/Argentina/Buenos_Aires
# TRUST_PROXY=1
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_MINUTES=15
